# Service
# SQLite by default; use postgresql+asyncpg://user:pass@host/db for PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/cache.db
LOG_LEVEL=INFO

# Simulated external transformer service
TRANSFORMER_LATENCY_SECONDS=0.05
TRANSFORMER_TIMEOUT_SECONDS=10.0

# cache-cli takes command line flags only, by design; see the README.
