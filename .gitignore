# Bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Secrets and local overrides. `.env.example` is committed as the template.
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Coverage reports
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local database files: the service defaults to on-disk SQLite
*.db
*.db-journal
*.db-wal
*.sqlite3
data/

# Editors
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Note: uv.lock is intentionally NOT ignored. It pins the exact dependency
# versions, so CI and the Docker image build from the same resolution.
